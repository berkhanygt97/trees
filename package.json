{
  "name": "lan-casino-royale",
  "version": "1.0.0",
  "description": "A LAN-hosted first-person casino party game. 10-minute rounds, everyone starts with the same money, biggest profit wins. Ships as a desktop host app or a plain Node server.",
  "type": "module",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "desktop": "electron .",
    "icon": "node desktop/make-icon.mjs",
    "build:desktop": "npx --yes electron-builder",
    "build:win": "npx --yes electron-builder --win",
    "build:mac": "npx --yes electron-builder --mac",
    "build:linux": "npx --yes electron-builder --linux"
  },
  "dependencies": {
    "three": "^0.169.0",
    "ws": "^8.18.0"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "private": true,
  "devDependencies": {
    "electron": "^33.4.11"
  },
  "main": "desktop/main.js",
  "build": {
    "appId": "com.lanparty.casinoroyale",
    "productName": "Casino Royale",
    "artifactName": "CasinoRoyale-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "desktop/**/*",
      "server/**/*",
      "shared/**/*",
      "public/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.games"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "executableName": "casino-royale",
      "synopsis": "LAN casino party game",
      "syncDesktopName": true
    }
  },
  "author": "LAN Party",
  "desktopName": "casino-royale.desktop"
}
